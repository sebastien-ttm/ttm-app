{#
    « Qui s'exprime ? » : liste des personnes autorisées à s'exprimer en réunion — membres du CoDir, puis entraîneurs invités.
    Variables : input (style), speakersCodir, speakersCoaches, speakerNames (noms complets de la liste),
    current (intervenant déjà enregistré d'un point existant, sinon null), defaultId (pré-sélection à l'ajout, sinon null).
    name : nom du champ posté (« speaker » par défaut ; « respondent » pour « Qui répond ? »).
    collective : libellé d'une réponse collective (« CoDir ») proposée avant les personnes, ou absent ; emptyLabel : libellé
    de l'option vide (« — personne — » par défaut).
    Valeur postée : identifiant du compte, « codir » (réponse collective), « » (vide) ou « keep » (conserver une
    ancienne saisie libre non reconnue).
#}
{% set collectiveLabel = collective|default(null) %}
{% set isCollective = collectiveLabel and current and current|lower == collectiveLabel|lower %}
<select name="{{ name|default('speaker') }}" style="{{ input }}">
    <option value="">{{ emptyLabel|default('— personne —') }}</option>
    {% if collectiveLabel %}
        <option value="codir" {{ isCollective ? 'selected' : '' }}>{{ collectiveLabel }} (collectif)</option>
    {% endif %}
    {% if current and not isCollective and current not in speakerNames %}
        <option value="keep" selected>{{ current }} (saisie libre actuelle)</option>
    {% endif %}
    {% if speakersCodir|length > 0 %}
        <optgroup label="Comité directeur">
            {% for u in speakersCodir %}
                <option value="{{ u.id }}" {{ (current ? u.fullName == current : u.id == defaultId) ? 'selected' : '' }}>{{ u.fullName }} ({{ u.boardRole.label }})</option>
            {% endfor %}
        </optgroup>
    {% endif %}
    {% if speakersCoaches|length > 0 %}
        <optgroup label="Entraîneurs invités">
            {% for u in speakersCoaches %}
                <option value="{{ u.id }}" {{ (current ? u.fullName == current : u.id == defaultId) ? 'selected' : '' }}>{{ u.fullName }}</option>
            {% endfor %}
        </optgroup>
    {% endif %}
</select>
