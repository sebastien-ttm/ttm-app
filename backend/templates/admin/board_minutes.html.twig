<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Compte rendu · {{ meeting.label }}</title>
    <style>
        :root { --navy:#0d2148; --muted:#64748b; --line:#e2e8f0; }
        * { box-sizing:border-box; }
        body { margin:0; background:#f1f5f9; color:#0f172a; font:15px/1.5 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        .toolbar { position:sticky; top:0; z-index:2; display:flex; gap:10px; flex-wrap:wrap; align-items:center; padding:10px 16px; background:#fff; border-bottom:1px solid var(--line); }
        .toolbar a, .toolbar button { font:inherit; font-size:14px; padding:6px 14px; border-radius:6px; border:1px solid #cbd5e1; background:#fff; color:#0f172a; text-decoration:none; cursor:pointer; }
        .toolbar .primary { background:var(--navy); border-color:var(--navy); color:#fff; font-weight:600; }
        .toolbar .hint { font-size:13px; color:var(--muted); }
        .page { max-width:860px; margin:20px auto; padding:36px 44px; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.1); }
        h1 { margin:0 0 2px; font-size:26px; color:var(--navy); }
        .sub { color:var(--muted); font-size:14px; }
        .summary { margin:14px 0 4px; padding:10px 14px; background:#f8fafc; border-left:4px solid var(--navy); font-size:14px; }
        .notes { margin:10px 0 0; font-size:14px; white-space:pre-line; }
        .attendance { margin:12px 0 0; display:grid; gap:4px; font-size:14px; }
        .attendance .k { display:inline-block; min-width:92px; margin-right:6px; font-size:11px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; color:var(--muted); }
        h2 { margin:28px 0 8px; padding-bottom:4px; border-bottom:2px solid var(--navy); font-size:16px; letter-spacing:.6px; text-transform:uppercase; color:var(--navy); }
        .point { margin:0 0 16px; padding-left:12px; border-left:3px solid var(--line); break-inside:avoid; }
        .head { display:flex; gap:8px; align-items:baseline; flex-wrap:wrap; }
        .tag { font-size:11px; font-weight:700; padding:1px 8px; border-radius:3px; background:#e0e7ff; color:#3730a3; }
        .tag.sujet { background:#fef3c7; color:#92400e; }
        .tag.question { background:#fce7f3; color:#9d174d; }
        .who { font-weight:700; }
        .text { margin:3px 0 6px; white-space:pre-line; }
        .block { margin:6px 0 0; font-size:14px; }
        .block .k { display:block; font-size:11px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; color:var(--muted); }
        .block ul { margin:2px 0 0; padding-left:18px; }
        .block li { margin:1px 0; }
        .block .free { white-space:pre-line; }
        .decision { padding:6px 10px; background:#f0fdf4; border-radius:4px; }
        .due { color:var(--muted); }
        .done { color:#166534; font-weight:600; }
        .new { display:inline-block; margin-left:6px; font-size:10px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; padding:0 6px; border-radius:3px; background:#e0e7ff; color:#3730a3; }
        .late { display:inline-block; font-size:11px; font-weight:700; color:#b91c1c; }
        .pending { color:var(--muted); font-style:italic; font-size:14px; margin-top:6px; }
        table { width:100%; border-collapse:collapse; margin-top:6px; font-size:14px; }
        th, td { text-align:left; vertical-align:top; padding:6px 8px; border:1px solid var(--line); }
        th { background:#f1f5f9; font-size:12px; text-transform:uppercase; letter-spacing:.4px; }
        .signoff { margin-top:36px; display:flex; justify-content:flex-end; gap:40px; flex-wrap:wrap; break-inside:avoid; }
        .sign { min-width:240px; text-align:center; }
        .sign .role { font-size:12px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; color:var(--muted); }
        .sign img { display:block; max-width:260px; max-height:100px; margin:8px auto 4px; }
        .sign .blank { height:70px; margin:8px 0 4px; border-bottom:1px solid #94a3b8; }
        .sign .name { font-weight:700; }
        .toolbar .warn { color:#b45309; }
        .foot { margin-top:30px; font-size:12px; color:var(--muted); }
        @media print {
            body { background:#fff; }
            .toolbar { display:none; }
            .page { margin:0; max-width:none; padding:0; box-shadow:none; }
            h2 { break-after:avoid; }
            tr { break-inside:avoid; }
            @page { margin:16mm; }
        }
        @media (max-width:640px) { .page { margin:0; padding:20px 16px; } }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" class="primary" onclick="window.print()">Imprimer / enregistrer en PDF</button>
        <a href="{{ path('admin_board_session', {meeting: meeting.id}) }}">← Retour à la séance</a>
        <a href="{{ path('admin_board_export', {id: meeting.id}) }}">Export CSV</a>
        <span class="hint">Le compte rendu se met à jour à chaque rechargement de la page.</span>
        {# Rappel (écran seulement, la barre n'est pas imprimée) : la signature du secrétaire se règle sur sa fiche utilisateur #}
        {% if secretaries is empty %}
            <span class="hint warn">Aucun compte n'a le rôle CODIR « Secrétaire » : la signature n'est pas insérée.</span>
        {% else %}
            {% for s in secretaries %}
                {% if not s.hasSignature %}
                    <span class="hint warn">Signature de {{ s.name }} non renseignée : à ajouter dans Utilisateurs › sa fiche › « Signature (compte rendu du CODIR) ».</span>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>

    <main class="page">
        <h1>Compte rendu du Comité directeur</h1>
        <div class="sub">
            {{ meeting.label }} · {{ meeting.scheduledAt|date('H\\hi') }}{{ meeting.location ? ' · ' ~ meeting.location : '' }}
        </div>
        <div class="summary">
            {{ meeting.itemCount }} point{{ meeting.itemCount > 1 ? 's' : '' }} à l'ordre du jour
            · {{ meeting.answeredCount }} traité{{ meeting.answeredCount > 1 ? 's' : '' }}
            · {{ commentCount }} commentaire{{ commentCount > 1 ? 's' : '' }} ou réponse{{ commentCount > 1 ? 's' : '' }} des membres
            · {{ decidedCount }} action{{ decidedCount > 1 ? 's' : '' }} décidée{{ decidedCount > 1 ? 's' : '' }}
            · {{ openActions|length }} action{{ openActions|length > 1 ? 's' : '' }} en cours
        </div>
        {% if meeting.notes %}<div class="notes">{{ meeting.notes }}</div>{% endif %}

        {# Présences : présents (avec leur rôle au CoDir), excusés, invités (avec leur qualité / organisme) #}
        {% if meeting.hasAttendance %}
            {% set present = meeting.present %}
            {% set excused = meeting.excused %}
            {% set guests = meeting.guests %}
            <div class="attendance">
                {% if present|length > 0 %}
                    <div><span class="k">Présent{{ present|length > 1 ? 's' : '' }} ({{ present|length }})</span>
                        {% for a in present %}{{ a.displayName }}{% if a.boardRoleLabel %} <span class="due">({{ a.boardRoleLabel }})</span>{% endif %}{{ loop.last ? '' : ', ' }}{% endfor %}</div>
                {% endif %}
                {% if excused|length > 0 %}
                    <div><span class="k">Excusé{{ excused|length > 1 ? 's' : '' }} ({{ excused|length }})</span>
                        {% for a in excused %}{{ a.displayName }}{% if a.boardRoleLabel %} <span class="due">({{ a.boardRoleLabel }})</span>{% endif %}{{ loop.last ? '' : ', ' }}{% endfor %}</div>
                {% endif %}
                {% if guests|length > 0 %}
                    <div><span class="k">Invité{{ guests|length > 1 ? 's' : '' }} ({{ guests|length }})</span>
                        {% for a in guests %}{{ a.displayName }}{% if a.note %} <span class="due">({{ a.note }})</span>{% endif %}{{ loop.last ? '' : ', ' }}{% endfor %}</div>
                {% endif %}
            </div>
        {% endif %}

        {% if groups is empty %}
            <p class="pending">Aucun point n'a été inscrit à l'ordre du jour.</p>
        {% endif %}

        {% for poleLabel, items in groups %}
            <h2>{{ poleLabel }}</h2>
            {% for item in items %}
                <section class="point">
                    <div class="head">
                        <span class="tag {{ item.type.value }}">{{ item.type.label }}</span>
                        <span class="who">{{ item.speaker ?: '—' }}</span>
                    </div>
                    <div class="text">{{ item.text }}</div>

                    {% if item.comments|length > 0 %}
                        <div class="block">
                            <span class="k">{{ item.commentsLabel }} des membres</span>
                            <ul>
                                {# En fil : une réponse est en retrait, avec le nom de l'auteur du commentaire auquel elle répond #}
                                {% for t in item.threadedComments %}
                                    <li style="{{ t.depth > 0 ? 'margin-left:' ~ (t.depth * 18) ~ 'px; list-style:none;' : '' }}">
                                        {% if t.replyTo %}↳ {% endif %}<strong>{{ t.comment.authorName }}</strong>{% if t.replyTo %} <span style="color:#64748b;">(à {{ t.replyTo }})</span>{% endif %} : <span class="free">{{ t.comment.text }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {% if item.respondent or item.answer %}
                        <div class="block decision">
                            <span class="k">{{ item.type.value == 'question' ? 'Réponse' : 'Décision / réponse' }}{{ item.respondent ? ' · ' ~ item.respondent : '' }}</span>
                            {% if item.answer %}<div style="white-space:pre-line;">{{ item.answer }}</div>{% endif %}
                        </div>
                    {% elseif item.actions|length == 0 and not item.actionOwner %}
                        <div class="pending">Point non traité en séance.</div>
                    {% endif %}

                    {% if item.actions|length > 0 or item.actionOwner %}
                        <div class="block">
                            <span class="k">Action{{ item.actions|length + (item.actionOwner ? 1 : 0) > 1 ? 's' : '' }}</span>
                            <ul>
                                {% for a in item.actions %}
                                    <li>
                                        <span class="free">{{ a.text }}</span>{% if a.assignees|length > 0 %} — <strong>{{ a.assigneeNames|join(', ') }}</strong>{% endif %}
                                        {% if a.dueDate %}<span class="due">· échéance {{ a.dueDate|date('d/m/Y') }}</span>{% endif %}
                                        {% if a.closed %}<span class="done">· clôturée le {{ a.closedAt|date('d/m/Y') }}</span>{% endif %}
                                    </li>
                                {% endfor %}
                                {% if item.actionOwner %}<li>Porteur : <strong>{{ item.actionOwner }}</strong></li>{% endif %}
                            </ul>
                        </div>
                    {% endif %}
                </section>
            {% endfor %}
        {% endfor %}

        <h2>Actions en cours</h2>
        {% if openActions|length > 0 %}
            <table>
                <thead><tr><th>Action</th><th>Point concerné</th><th>Porteur(s)</th><th>Échéance</th></tr></thead>
                <tbody>
                    {% for a in openActions %}
                        <tr>
                            <td style="white-space:pre-line;">
                                {{ a.text }}
                                {% if a.item.meeting.id == meeting.id %}<span class="new">Nouvelle</span>{% endif %}
                            </td>
                            <td>
                                <span style="color:#64748b; font-size:12px;">{{ a.item.meeting.label }} · {{ a.item.pole.label }}</span><br>
                                {{ a.item.text|length > 110 ? a.item.text|slice(0, 110) ~ '…' : a.item.text }}
                            </td>
                            <td>{{ a.assigneeNames|join(', ') ?: '—' }}</td>
                            <td style="white-space:nowrap;">
                                {{ a.dueDate ? a.dueDate|date('d/m/Y') : '—' }}
                                {% if a.overdue %}<br><span class="late">En retard</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="pending">Aucune action en cours.</p>
        {% endif %}

        {# Signature du secrétaire : le compte qui a le rôle CODIR « Secrétaire », avec sa signature manuscrite si elle est renseignée (sinon la place de signer à la main). #}
        <div class="signoff">
            {% for s in secretaries %}
                <div class="sign">
                    <div class="role">{{ s.role }} du Comité directeur</div>
                    {% if s.signature %}<img src="{{ s.signature }}" alt="Signature de {{ s.name }}">{% else %}<div class="blank"></div>{% endif %}
                    <div class="name">{{ s.name }}</div>
                </div>
            {% else %}
                <div class="sign">
                    <div class="role">Secrétaire du Comité directeur</div>
                    <div class="blank"></div>
                </div>
            {% endfor %}
        </div>

        <div class="foot">Document généré le {{ 'now'|date('d/m/Y à H\\hi') }} depuis l'application du club.</div>
    </main>
</body>
</html>
