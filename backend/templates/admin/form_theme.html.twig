{# Custom form theme : overrides EasyAdmin's rich-text widget to use
   TinyMCE 7 (community) instead of Trix. TinyMCE has native image
   resize handles via the `image` plugin. #}

{% block ea_text_editor_widget %}
    {% set widget_id = 'tmce-' ~ (id|default('content')) %}
    {# No `required` HTML5 attribute : TinyMCE hides the underlying textarea
       and the browser then refuses to submit the form for a hidden invalid
       field, silently in some browsers. Server-side validation (NotBlank)
       handles emptiness with a proper error message after submit. #}
    <textarea
        id="{{ widget_id }}"
        name="{{ full_name }}"
        class="form-control ttm-rich-editor"
        rows="{{ form.vars.ea_vars.field.customOptions.get('numOfRows')|default(15) }}"
    >{{- value -}}</textarea>

    <script>
    (function () {
        var targetId = {{ widget_id|json_encode|raw }};

        function imageUploadHandler(blobInfo, progress) {
            return new Promise(function (resolve, reject) {
                var data = new FormData();
                data.append('file', blobInfo.blob(), blobInfo.filename());
                fetch('/admin/upload/inline', {
                    method: 'POST',
                    body: data,
                    credentials: 'same-origin',
                })
                    .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
                    .then(function (res) {
                        if (!res.ok) {
                            var msg = (res.body && res.body.error && res.body.error.message) || 'Upload échoué';
                            return reject({ message: msg, remove: true });
                        }
                        if (!res.body.url) { return reject({ message: 'Réponse upload invalide', remove: true }); }
                        resolve(res.body.url);
                    })
                    .catch(function (err) { reject({ message: String(err), remove: true }); });
            });
        }

        function init() {
            var el = document.getElementById(targetId);
            if (!el || el.dataset.tmceInit) return;
            if (typeof tinymce === 'undefined') {
                setTimeout(init, 80);
                return;
            }
            el.dataset.tmceInit = '1';

            tinymce.init({
                selector: '#' + targetId,
                license_key: 'gpl',
                language: 'fr_FR',
                language_url: 'https://cdn.jsdelivr.net/npm/tinymce-i18n@latest/langs7/fr_FR.js',
                height: 420,
                min_height: 320,
                menubar: false,
                branding: false,
                promotion: false,
                statusbar: true,
                resize: true,
                plugins: 'autoresize lists link image table code emoticons',
                toolbar:
                    'undo redo | blocks | bold italic underline | bullist numlist | ' +
                    'link image table emoticons ttmButton | alignleft aligncenter alignright alignjustify | code',
                block_formats: 'Paragraphe=p; Titre 2=h2; Titre 3=h3; Citation=blockquote',
                image_caption: true,
                image_advtab: true,
                image_dimensions: true,
                image_title: false,
                automatic_uploads: true,
                images_upload_handler: imageUploadHandler,
                images_reuse_filename: true,
                /* Stocke les accents tels quels (é, à) plutôt que de les
                   encoder en entités (&eacute;, &agrave;). Sinon le mobile
                   affiche les entités littérales dans les aperçus. */
                entity_encoding: 'raw',
                /* Préserve toutes les balises img (avec leurs attributs)
                   en sortie ; sans ça, certaines configurations TinyMCE
                   peuvent stripper des attributs ou la balise elle-même. */
                extended_valid_elements: 'img[src|alt|title|width|height|style|class|data-*],a[href|title|target|rel|class]',
                content_style:
                    'body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; ' +
                    'font-size: 15px; line-height: 1.55; padding: 8px 16px; margin: 0; ' +
                    'caret-color: #D32F2F; } ' +
                    'body > p:first-child { margin-top: 0; } ' +
                    'img { max-width: 100%; height: auto; } ' +
                    /* Rendu WYSIWYG des boutons — même look que côté mobile. */
                    'a.ttm-btn { display: inline-block; padding: 10px 18px; border-radius: 8px; ' +
                    'text-decoration: none !important; font-weight: 600; color: #fff !important; margin: 4px 2px; } ' +
                    'a.ttm-btn.ttm-btn-primary { background: #0d2148; } ' +
                    'a.ttm-btn.ttm-btn-secondary { background: #D32F2F; } ' +
                    'a.ttm-btn.ttm-btn-outline { background: transparent; color: #0d2148 !important; ' +
                    'border: 2px solid #0d2148; } ' +
                    /* Astuce : un paragraphe vide n\'a pas de largeur, donc le curseur est invisible.
                       On force une min-height pour qu\'il s\'affiche bien sur le placeholder. */
                    'p:empty::before { content: ""; display: inline-block; }',
                setup: function (editor) {
                    /* Bouton personnalisé « Bouton » : split-menu offrant 3
                       variantes (Principal, Secondaire, Contour). Chaque
                       variante ouvre une dialog qui insère un
                       <a class="ttm-btn ttm-btn-<variante>" href="..."> pré-stylé
                       par les règles CSS injectées côté content_style + mobile. */
                    var openButtonDialog = function (variant) {
                        var sel = editor.selection.getContent({ format: 'text' });
                        editor.windowManager.open({
                            title: 'Insérer un bouton',
                            body: {
                                type: 'panel',
                                items: [
                                    { type: 'input', name: 'label', label: 'Texte du bouton' },
                                    { type: 'input', name: 'href', label: 'URL (https://... ou /page/…)' },
                                    { type: 'checkbox', name: 'newTab', label: 'Ouvrir dans un nouvel onglet' },
                                ],
                            },
                            initialData: { label: sel || '', href: '', newTab: true },
                            buttons: [
                                { type: 'cancel', text: 'Annuler' },
                                { type: 'submit', text: 'Insérer', primary: true },
                            ],
                            onSubmit: function (api) {
                                var d = api.getData();
                                var label = (d.label || '').trim();
                                var href = (d.href || '').trim();
                                if (label === '' || href === '') { api.close(); return; }
                                var esc = function (s) {
                                    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
                                        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                                };
                                var attrs = 'href="' + esc(href) + '" class="ttm-btn ttm-btn-' + variant + '"';
                                if (d.newTab) { attrs += ' target="_blank" rel="noopener"'; }
                                editor.insertContent('<a ' + attrs + '>' + esc(label) + '</a>&nbsp;');
                                api.close();
                            },
                        });
                    };

                    editor.ui.registry.addMenuButton('ttmButton', {
                        text: 'Bouton',
                        tooltip: 'Insérer un bouton',
                        fetch: function (cb) {
                            cb([
                                { type: 'menuitem', text: 'Bouton principal (bleu)',
                                  onAction: function () { openButtonDialog('primary'); } },
                                { type: 'menuitem', text: 'Bouton secondaire (rouge)',
                                  onAction: function () { openButtonDialog('secondary'); } },
                                { type: 'menuitem', text: 'Bouton contour',
                                  onAction: function () { openButtonDialog('outline'); } },
                            ]);
                        },
                    });

                    // Sync content back to the textarea on every change AND right
                    // before the form is submitted, in case TinyMCE's own submit
                    // hook is bypassed by client-side validation handlers.
                    editor.on('change keyup undo redo', function () { editor.save(); });
                    editor.on('init', function () {
                        // Place le curseur au tout début du contenu
                        try {
                            var body = editor.getBody();
                            if (body && body.firstChild) {
                                editor.selection.setCursorLocation(body.firstChild, 0);
                            }
                        } catch (e) { /* ignore */ }

                        // Hook submit form pour synchroniser le contenu
                        var form = editor.targetElm.form;
                        if (form && !form.dataset.tmceSubmitHook) {
                            form.dataset.tmceSubmitHook = '1';
                            form.addEventListener('submit', function () { editor.save(); }, true);
                        }
                    });
                },
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
    </script>
{% endblock ea_text_editor_widget %}
