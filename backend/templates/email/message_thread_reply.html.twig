<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouvelle réponse dans votre conversation</title>
</head>
<body style="font-family: Arial, sans-serif; background:#f4f4f4; padding:20px; color:#222;">
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="600" style="background:#fff; border-radius:8px; overflow:hidden;">
        <tr>
            <td style="background:#D32F2F; color:#fff; padding:20px; text-align:center;">
                <h1 style="margin:0; font-size:22px;">Triathlon Toulouse Métropole</h1>
            </td>
        </tr>
        <tr>
            <td style="padding:30px;">
                <p>Bonjour <strong>{{ target.prenom }}</strong>,</p>

                <p>
                    <strong>{{ reply.author.fullName }}</strong>
                    a répondu dans votre conversation
                    {% if message.subject %} « {{ message.subject }} »{% endif %}.
                </p>

                <div style="margin:18px 0; padding:14px; background:#f0fdf4; border-left:4px solid #16a34a; border-radius:4px; font-size:14px; color:#0d2148; line-height:1.5;">
                    {{ reply.content|nl2br }}
                </div>

                <p style="text-align:center; margin:30px 0;">
                    <a href="{{ threadUrl }}" style="display:inline-block; background:#D32F2F; color:#fff; padding:14px 28px; text-decoration:none; border-radius:6px; font-weight:bold;">
                        Voir et répondre
                    </a>
                </p>

                <hr style="border:none; border-top:1px solid #eee; margin:30px 0;">

                <p style="font-size:12px; color:#999;">
                    Envoyé le {{ reply.createdAt|date('d/m/Y à H:i') }}.
                </p>
            </td>
        </tr>
        <tr>
            <td style="background:#222; color:#aaa; padding:15px; text-align:center; font-size:12px;">
                Triathlon Toulouse Métropole — message automatique, ne pas répondre
            </td>
        </tr>
    </table>
</body>
</html>
