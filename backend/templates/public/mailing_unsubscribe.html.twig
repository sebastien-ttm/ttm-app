<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Mailings du club — {{ app_name }}</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;
               font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; background: #0d2148; color: #111827; }
        .card { width: 100%; max-width: 440px; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,.3); }
        .head { background: #D32F2F; color: #fff; padding: 18px 24px; font-size: 18px; font-weight: 700; text-align: center; }
        .body { padding: 26px 24px 28px; line-height: 1.55; text-align: center; }
        h1 { margin: 0 0 12px; font-size: 21px; }
        p { margin: 0 0 18px; font-size: 16px; color: #374151; }
        .ok { color: #166534; font-weight: 700; }
        button { min-height: 48px; padding: 12px 26px; border: 0; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; background: #D32F2F; color: #fff; }
        button.secondary { background: #fff; color: #0d2148; border: 1px solid #cbd5e1; }
        .small { margin: 18px 0 0; font-size: 13px; color: #6b7280; }
    </style>
</head>
<body>
    <div class="card">
        <div class="head">{{ app_name }}</div>
        <div class="body">
            {% if optedOut %}
                {% if changed %}
                    <h1 class="ok">C'est fait ✓</h1>
                    <p>{{ prenom }}, vous ne recevrez plus les mailings du club.</p>
                {% else %}
                    <h1>Vous êtes désinscrit(e)</h1>
                    <p>{{ prenom }}, vous ne recevez plus les mailings du club.</p>
                {% endif %}
                <form method="post">
                    <input type="hidden" name="action" value="resubscribe">
                    <button type="submit" class="secondary">Me réinscrire</button>
                </form>
                <p class="small">Vous continuerez à recevoir les messages liés à votre compte (connexion, messages qui vous sont adressés).</p>
            {% else %}
                {% if changed %}
                    <h1 class="ok">Vous êtes réinscrit(e) ✓</h1>
                    <p>{{ prenom }}, vous recevrez de nouveau les mailings du club.</p>
                {% else %}
                    <h1>Se désinscrire des mailings</h1>
                    <p>{{ prenom }}, souhaitez-vous ne plus recevoir les mailings du club&nbsp;?</p>
                {% endif %}
                {% if not changed %}
                    <form method="post">
                        <input type="hidden" name="action" value="unsubscribe">
                        <button type="submit">Me désinscrire</button>
                    </form>
                    <p class="small">Vous continuerez à recevoir les messages liés à votre compte (connexion, messages qui vous sont adressés).</p>
                {% endif %}
            {% endif %}
        </div>
    </div>
</body>
</html>
